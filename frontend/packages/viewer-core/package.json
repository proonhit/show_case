{
  "name": "@showcase/viewer-core",
  "version": "0.3.0",
  "private": true,
  "description": "Three.js model viewer: 360° turntable and 7 texture-map modes. Framework-free, with an optional thin Vue wrapper. Consumed as TypeScript source inside the workspace; `build` checks it bundles.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vue": "./src/vue.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": ">=0.170.0 <0.180.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "~0.170.0",
    "three": "~0.170.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
