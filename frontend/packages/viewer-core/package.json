{
  "name": "@showcase/viewer-core",
  "version": "0.3.0",
  "private": true,
  "description": "Three.js model viewer: 360° turntable and 7 texture-map modes. Framework-free, with an optional thin Vue wrapper.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vue": { "types": "./dist/vue.d.ts", "import": "./dist/vue.js" }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": ">=0.170.0 <0.180.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@types/three": "~0.170.0",
    "three": "~0.170.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
