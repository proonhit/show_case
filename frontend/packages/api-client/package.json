{
  "name": "@showcase/api-client",
  "version": "0.4.0",
  "private": true,
  "description": "Typed client for the Showcase API, generated from its OpenAPI document.",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "openapi-typescript openapi/Showcase.Api.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.7.0"
  }
}
