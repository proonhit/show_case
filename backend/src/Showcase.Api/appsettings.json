{
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "AdminPasswordHash": "",
    "SessionVersion": 1,
    "LoginPermitPerMinute": 5
  },
  "Storage": {
    "Root": "/data/uploads"
  },
  "Upload": {
    "TempPath": "/data/tus",
    "MaxMegabytes": 100
  },
  "Database": {
    "AutoMigrate": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
