# Copy to deploy/.env and fill in. Never commit the real .env.

# PostgreSQL
POSTGRES_DB=showcase
POSTGRES_USER=showcase
POSTGRES_PASSWORD=change-me

# Studio login: hash of the single admin password (generated by a CLI command in GĐ1)
ADMIN_PASSWORD_HASH=

# Key used to sign the session cookie; rotate it to log out every session
COOKIE_SIGNING_KEY=

# Where uploaded files live inside the containers
UPLOAD_ROOT=/data/uploads
UPLOAD_MAX_MB=100

# Cloudflare (GĐ5–GĐ6)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
