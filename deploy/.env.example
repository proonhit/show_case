# Copy to deploy/.env and fill in. Never commit the real .env.

# PostgreSQL
POSTGRES_DB=showcase
POSTGRES_USER=showcase
POSTGRES_PASSWORD=change-me

# Studio login: hash of the single admin password. Generate it with
#   docker run --rm showcase-api:dev hash-password "your-password"
# (or: dotnet run --project backend/src/Showcase.Api -- hash-password "your-password")
# To log out every session, bump Auth__SessionVersion.
ADMIN_PASSWORD_HASH=

# Largest upload in MB. Files live in the "uploads" volume (/data/uploads in the containers).
UPLOAD_MAX_MB=100

# Cloudflare (GĐ5–GĐ6)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
